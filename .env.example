# Site / checkout
NEXT_PUBLIC_SITE_URL=https://www.agotrancoso.com.br
INFINITEPAY_HANDLE=ago-trancoso

# Benefício de primeira compra (Upstash Redis via Vercel Marketplace)
# Use variáveis criptografadas no ambiente da Vercel. Nunca versione valores reais aqui.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Compatibilidade com integrações Vercel KV antigas, caso existam:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Prazo real de entrega
# O preço comercial do site continua sendo controlado por lib/shipping.ts.
# API Prazo dos Correios: consulta apenas serviço e CEPs, sem peso ou dimensões.
# Token autorizado para a API Prazo (34); configure o segredo somente na Vercel.
CORREIOS_TOKEN=
CORREIOS_SERVICE_CODE=03298
SHIP_FROM_CEP=46098000
# Integração alternativa de prazo:
FRENET_TOKEN=
FRENET_SELLER_CEP=

# Código de verificação da propriedade no Google Search Console (somente o conteúdo da meta tag).
GOOGLE_SITE_VERIFICATION=

# Marketing / analytics
# Defina esses valores na Vercel para ativar o rastreamento.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
