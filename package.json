{
  "name": "agotrancoso-loja",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/normalize-product-images.mjs && node scripts/fix-pretos-velhos-images.mjs && node scripts/audit-catalog.mjs && node scripts/verify-recovered-features.cjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "audit:catalog": "node scripts/audit-catalog.mjs",
    "qa:commerce": "node scripts/qa-commerce.cjs && node scripts/qa-payment-return.cjs",
    "qa:ui": "node scripts/qa-ui.cjs",
    "qa:analytics": "node scripts/qa-analytics.cjs",
    "verify:recovered": "node scripts/verify-recovered-features.cjs",
    "verify": "npm run typecheck && npm run audit:catalog && npm run verify:recovered && npm run build",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "15.5.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.33.5"
  },
  "devDependencies": {
    "@types/node": "20.14.15",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.40",
    "tailwindcss": "3.4.7",
    "typescript": "5.5.4"
  },
  "overrides": {
    "electron-to-chromium": "1.5.439"
  }
}
